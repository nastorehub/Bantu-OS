[Unit]
Description=Bantu OS: apply a reset that `bantu-os reset` scheduled (erase the account, run setup again)
ConditionPathExists=/var/lib/bantu-os/reset-pending
Before=bantu-os-firstboot.service greetd.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/bantu-os/reset-helper apply

[Install]
WantedBy=multi-user.target
