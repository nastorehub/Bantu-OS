[Unit]
Description=Bantu OS: install NasTech Agent once the computer is online (the first boot had no network)
# firstboot.sh system leaves the note when it could not install NasTech; this removes it once NasTech is
# installed and set up. The shell waits for that, so it never starts a NasTech still being installed.
ConditionPathExists=/var/lib/bantu-os/nastech-pending
Wants=network-online.target
After=network-online.target bantu-os-firstboot.service

[Service]
# Waits for the network and retries a failed install itself; `exec`, so the boot never waits on it.
Type=exec
ExecStart=/usr/libexec/bantu-os/firstboot.sh nastech
Restart=on-failure
RestartSec=5min
Nice=10

[Install]
WantedBy=multi-user.target
