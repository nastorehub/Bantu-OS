[Unit]
Description=Bantu OS: first-boot apps (the omakase Flatpaks), while the session is already up
ConditionPathExists=!/var/lib/bantu-os/firstboot-apps-done
Wants=network-online.target
After=network-online.target bantu-os-firstboot.service greetd.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/bantu-os/firstboot.sh apps
TimeoutStartSec=2h
Nice=10

[Install]
WantedBy=multi-user.target
