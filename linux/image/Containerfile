# Bantu OS Linux as a bootable container image (ADR-018): Fedora bootc with the Bantu OS session,
# the CLIs and the prebuilt shell. Updates replace the whole image (bootc upgrade) and the previous
# one stays in the boot menu. Built by .github/workflows/image.yml; locally, from the repo root, with
# the shell tarball for the same architecture next to it:
#
#   podman build -f linux/image/Containerfile --build-arg SHELL_TARBALL=bantu-os-linux.tar.gz -t bantu-os .
FROM quay.io/fedora/fedora-bootc:44

ARG SHELL_TARBALL=bantu-os-linux.tar.gz
COPY linux /tmp/bantu-os/linux
COPY ${SHELL_TARBALL} /tmp/bantu-os/shell.tar.gz

RUN bash /tmp/bantu-os/linux/image/packages.sh --image /tmp/bantu-os/shell.tar.gz \
 && dnf clean all \
 && rm -rf /tmp/bantu-os /var/cache/* /var/log/* /var/lib/dnf

LABEL org.opencontainers.image.title="Bantu OS" \
      org.opencontainers.image.description="An AI-native desktop built around NasTech Agent" \
      org.opencontainers.image.source="https://github.com/nastorehub/Bantu-OS" \
      org.opencontainers.image.licenses="MIT" \
      containers.bootc="1"

RUN bootc container lint
