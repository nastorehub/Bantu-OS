[Unit]
Description=Bantu OS: first-boot setup (the session user, the home folder, NasTech Agent)
# Once per machine; `bantu-os reset` removes the stamp to run it again.
ConditionPathExists=!/var/lib/bantu-os/firstboot-done
Wants=network-online.target
After=network-online.target
Before=greetd.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/bantu-os/firstboot.sh system
StandardOutput=journal+console
TimeoutStartSec=45min
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
