#!/usr/bin/env bash
# Entry point greetd runs as the session user: start the compositor with the Bantu OS shell.
#
#   BANTU_OS_COMPOSITOR=niri (default)  niri manages every window; the shell runs as panels.
#   BANTU_OS_COMPOSITOR=cage            Stage 1 kiosk: the shell is the only client.
set -u

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=BantuOS
export XDG_SESSION_DESKTOP=bantu-os

if ! ls /dev/dri/renderD* >/dev/null 2>&1; then
  export WLR_RENDERER=pixman
  export BANTU_OS_SOFTWARE_GPU=1
fi

# Optional per-machine overrides (compositor choice, output scale, dev server URL, extra flags).
if [[ -f "$HOME/.config/bantu-os/session.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$HOME/.config/bantu-os/session.env"
  set +a
fi
# Overrides written before the rename (NASTECH_OS_*) still apply; everything below reads BANTU_OS_*.
for legacy in "${!NASTECH_OS_@}"; do
  current="BANTU_OS_${legacy#NASTECH_OS_}"
  [[ -n "${!current:-}" ]] || export "$current=${!legacy}"
done

COMPOSITOR="${BANTU_OS_COMPOSITOR:-niri}"

# The compositor's own output is the only record of DRM/GPU/seat problems; keep the last run.
LOG_DIR="$HOME/.local/state/bantu-os"
mkdir -p "$LOG_DIR"
exec >>"$LOG_DIR/compositor.log" 2>&1
echo "$(date -Is) starting $COMPOSITOR (renderer=${WLR_RENDERER:-gpu})"

# Bantu's own niri config, rendered at every start from the installed template and the person's
# keymap (and written only when that changed, as after an update). niri is given it by path, so a
# personal ~/.config/niri/config.kdl is never read or rewritten. Without it niri would start bare,
# without Bantu OS, so the shell runs under cage instead.
NIRI_KDL="$HOME/.config/niri/bantu-os.kdl"
if [[ "$COMPOSITOR" != "cage" ]] && command -v niri >/dev/null 2>&1 && ! bantu-os keymap apply; then
  echo "could not render $NIRI_KDL (bantu-os keymap apply)"
fi

if [[ "$COMPOSITOR" == "cage" ]] || ! command -v niri >/dev/null 2>&1 || [[ ! -f "$NIRI_KDL" ]]; then
  export BANTU_OS_SHELL_MODE=desktop
  exec cage -s -- "$(command -v bantu-os-session)"
fi

export BANTU_OS_SHELL_MODE=panels

# Machine-specific niri settings live in local.kdl (included last by the managed config).
# BANTU_OS_SCALE applies to every connected output (and to the "winit" output used when niri is
# nested, below); the file is only written when it is missing so hand edits survive.
mkdir -p "$HOME/.config/niri"
if [[ ! -f "$HOME/.config/niri/local.kdl" ]]; then
  {
    echo "// Machine-specific niri overrides. Bantu OS never overwrites this file."
    if [[ -n "${BANTU_OS_SCALE:-}" ]]; then
      for status in /sys/class/drm/card*-*/status; do
        [[ "$(cat "$status" 2>/dev/null)" == "connected" ]] || continue
        name="$(basename "$(dirname "$status")")"
        name="${name#card*-}"
        printf 'output "%s" {\n    scale %s\n}\n' "$name" "$BANTU_OS_SCALE"
      done
      printf 'output "winit" {\n    scale %s\n}\n' "$BANTU_OS_SCALE"
    fi
  } >"$HOME/.config/niri/local.kdl"
fi

# theme.kdl is included by the managed config; make sure the active theme has written it.
if [[ ! -f "$HOME/.config/niri/theme.kdl" ]] && command -v bantu-os-theme >/dev/null; then
  bantu-os-theme set "$(bantu-os-theme current)" >/dev/null 2>&1 || echo "// theme pending" >"$HOME/.config/niri/theme.kdl"
fi
[[ -f "$HOME/.config/niri/theme.kdl" ]] || echo "// theme pending" >"$HOME/.config/niri/theme.kdl"
# The Display panel writes outputs.kdl; the managed config includes it, so it must exist.
[[ -f "$HOME/.config/niri/outputs.kdl" ]] || echo "// Written by the Bantu OS Display panel." >"$HOME/.config/niri/outputs.kdl"

# The shell scales through the compositor under niri; do not also zoom the page.
unset BANTU_OS_ZOOM

# niri drives displays through DRM and refuses software GL. A VM without 3D acceleration
# (virtio-gpu reporting `-virgl`, as in QEMU/Apple Virtualization without virgl) therefore gets no
# output at all. There, nest niri's windowed backend inside cage: cage owns the display with
# software rendering, niri runs fullscreen inside it and still manages every window.
# BANTU_OS_NIRI_NESTED=0|1 forces either way.
nested="${BANTU_OS_NIRI_NESTED:-auto}"
if [[ "$nested" == "auto" ]]; then
  nested=0
  if [[ -n "${WLR_RENDERER:-}" ]]; then
    nested=1
  elif journalctl -k -b --no-pager -o cat 2>/dev/null | grep -q 'features:.*-virgl'; then
    nested=1
  fi
fi

if [[ "$nested" == "1" ]]; then
  echo "no hardware GL: nesting niri (windowed) inside cage"
  exec cage -s -- "$(command -v bantu-os-niri-nested)"
fi

exec niri --session --config "$NIRI_KDL"
