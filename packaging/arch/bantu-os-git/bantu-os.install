post_install() {
  echo '==> Bantu OS is installed. Once per user, run:  bantu-os setup'
  echo '    (it installs NasTech Agent if needed and links the bridge plugin that lets it use the system).'
  echo '    Then pick "Bantu OS" on the login screen, or run bantu-os-app inside your desktop.'
  echo '    On Omarchy, `bantu-os omarchy install` adds it to the menu, the theme and the keys.'
}

post_upgrade() {
  echo '==> Bantu OS updated. Restart it (or log out and back in) to use the new version.'
}
