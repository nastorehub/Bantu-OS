# Bantu OS settings that come from the environment. All are optional and the defaults suit most
# people, so every line here is commented out.
#
# Nothing loads this file automatically:
#   macOS: export the variables you want before `npm run dev` (or `npm start`).
#   Linux: copy the lines you want into ~/.config/bantu-os/session.env, then
#          `sudo systemctl restart greetd`.
#
# Never put credentials here. NasTech Agent keeps API keys and logins in ~/.nastech (run `nastech setup`
# or open Settings in Bantu OS), and the shell never needs them.
#
# Names written before the rename (NASTECH_OS_*) are still read.

# ---- Shell window ----

# Kiosk window: no way to leave fullscreen.
# BANTU_OS_KIOSK=1

# Start windowed instead of fullscreen.
# BANTU_OS_WINDOWED=1

# Page zoom for the whole shell.
# BANTU_OS_ZOOM=1.25

# desktop (one window, the default) or panels (one window per surface, used by the niri session).
# BANTU_OS_SHELL_MODE=desktop

# ---- NasTech backend ----

# NasTech Agent checkout to run `nastech serve` from (default: ~/.nastech/nastech-agent).
# BANTU_OS_NASTECH_ROOT=/path/to/nastech-agent

# Working directory for new sessions (default: your home folder).
# BANTU_OS_DEFAULT_CWD=/path/to/projects

# Turn off the bantu-os-bridge plugin (desktop tools, UI control) without uninstalling it.
# BANTU_OS_BRIDGE_DISABLED=1

# NasTech home, if not ~/.nastech. Read by NasTech itself, the shell and the bridge.
# NASTECH_HOME=/path/to/.nastech

# ---- Development ----

# Load the renderer from a Vite dev server instead of the built files. `npm run dev` sets this.
# BANTU_OS_DEV_SERVER=http://127.0.0.1:5180

# Chrome DevTools protocol port, for scripted checks.
# BANTU_OS_REMOTE_DEBUG_PORT=9333

# ---- Linux session (session.env) ----

# Compositor: niri (panels, the default) or cage (one fullscreen window).
# BANTU_OS_COMPOSITOR=niri

# Run niri nested inside another Wayland session: 0, 1 or auto.
# BANTU_OS_NIRI_NESTED=auto

# Display scale for HiDPI screens (1.5 for 2048x1280, 2 for 2880x1800): niri's output scale, or
# the page zoom under cage.
# BANTU_OS_SCALE=1.5

# Lock the screen, then turn it off, after this many idle seconds.
# BANTU_OS_LOCK_AFTER=600
# BANTU_OS_SCREEN_OFF_AFTER=900

# Software rendering. Turned on automatically when there is no GPU render node (most VMs).
# BANTU_OS_SOFTWARE_GPU=1

# Disable Chromium's sandbox, only if user namespaces are unavailable.
# BANTU_OS_NO_SANDBOX=1

# Alternate shell build, or Electron binary.
# BANTU_OS_APP=/path/to/apps/desktop
# BANTU_OS_ELECTRON=/path/to/electron

# Checkout that bantu-os-update pulls from (default: ~/Bantu-OS).
# BANTU_OS_REPO=/path/to/Bantu-OS
